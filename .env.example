# Loaded only when explicitly using: node --env-file=.env mcp/dist/cli.js
HINGE_PHONE_NUMBER=+15555550123
# Use a private path outside the repository; one account/process per file.
# HINGE_SESSION_FILE=/private/path/session.json
HINGE_MCP_READ_ONLY=1
HINGE_MCP_ALLOW_RAW=0
HINGE_MCP_TIMEOUT_MS=30000

# HTTP only. Generate a random token; do not use this placeholder.
# HINGE_MCP_TOKEN=replace-with-32-random-bytes
HINGE_MCP_HOST=127.0.0.1
HINGE_MCP_PORT=3939
# Required when accessed through a public hostname/reverse proxy.
# HINGE_MCP_PUBLIC_URL=https://hinge.example.com/mcp
# Exact browser origins, comma separated; no wildcard.
# HINGE_MCP_ALLOWED_ORIGINS=http://localhost:6274

# OAuth resource-server mode instead of HINGE_MCP_TOKEN.
# Copy issuer EXACTLY, including any trailing slash.
# HINGE_MCP_OAUTH_ISSUER=https://auth.example.com/
# HINGE_MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# HINGE_MCP_OAUTH_SUBJECT=your-exact-owner-subject
